# --- Bot -------------------------------------------------------------------
DISCORD_TOKEN=
# Liste blanche de guildes autorisées, séparées par des virgules (ex: "111,222").
# Vide = pas de restriction (déploiement global des commandes, le bot accepte tout serveur).
DISCORD_GUILD_IDS=
# Base SQLite principale (compatible avec la base de la version TypeScript).
# Défaut : data/golmon.db. Toutes les données du bot sont rangées sous data/.
# DATABASE_URL="file:./data/golmon.db"
# Déploiement des slash commands au démarrage (true par défaut).
DEPLOY_COMMANDS=true
# Niveau de logs (tracing) : error, warn, info, debug, trace.
RUST_LOG=info

# --- Tickets (modmail) -------------------------------------------------------
# Optionnel : le module est activé dès qu'un config.ini existe ou qu'une
# variable MM_* est définie. Mêmes options que Dragory/modmailbot.
# MM_MAIN_SERVER_ID=111111111111111111
# MM_INBOX_SERVER_ID=111111111111111111
# MM_LOG_CHANNEL_ID=222222222222222222
# MM_MENTION_ROLE=333333333333333333
# MM_NEW_THREAD_CATEGORY_ID=444444444444444444
# MM_CLOSE_MESSAGE=Merci, ce ticket est maintenant fermé.
# MM_URL=https://logs.example.com
# MM_SQLITE_OPTIONS__FILENAME=./data/modmail.sqlite
