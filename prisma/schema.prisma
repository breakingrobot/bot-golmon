generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

// ---------- MODULE TRANSACTIONS ----------

enum TransactionType {
  ACHAT
  VENTE
}

enum TransactionStatus {
  PREPARATION
  EN_ATTENTE_RDV
  AVANCE_ATTENTE_PAIEMENT
  LIVRE_PAYE
  ANNULEE
}

model Transaction {
  id          String             @id @default(cuid())
  guildId     String
  channelId   String
  messageId   String?
  groupe      String
  type        TransactionType
  prix        Float
  statut      TransactionStatus  @default(PREPARATION)
  createdById String
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  items       TransactionItem[]

  @@index([guildId, channelId])
  @@index([guildId, statut])
  @@index([messageId])
}

model TransactionConfig {
  guildId            String   @id
  dashboardChannelId String?
  dashboardMessageId String?
  updatedAt          DateTime @updatedAt
}

model TransactionItem {
  id            String      @id @default(cuid())
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  nom           String
  quantite      Int         @default(1)
  prixUnitaire  Float?
  createdAt     DateTime    @default(now())

  @@index([transactionId])
}

// ---------- MODULE PRESENCES ----------

enum ResponseStatus {
  PRESENT
  ABSENT
  RETARD
}

model PresenceConfig {
  guildId           String   @id
  defaultRoleId     String?
  absenceRoleId     String?
  presenceChannelId String?
  reminderChannelId String?
  absenceChannelId  String?
  updatedAt         DateTime @updatedAt
}

model Absence {
  id          String    @id @default(cuid())
  guildId     String
  userId      String
  motif       String
  startsAt    DateTime
  endsAt      DateTime
  createdById String
  endedAt     DateTime?
  createdAt   DateTime  @default(now())

  @@index([guildId, userId])
  @@index([endedAt])
}

/// Membres à ne jamais ping pour les présences (auto-absents), indépendamment des absences ponctuelles.
model PresenceBlocklist {
  id        String   @id @default(cuid())
  guildId   String
  userId    String
  raison    String?
  addedById String
  createdAt DateTime @default(now())

  @@unique([guildId, userId])
}

model Presence {
  id              String             @id @default(cuid())
  guildId         String
  channelId       String
  messageId       String?
  titre           String
  description     String?
  eventDate       DateTime
  roleId          String
  absenceRoleId   String?
  createdById     String
  createdAt       DateTime           @default(now())
  closedAt        DateTime?
  lastReminderAt  DateTime?
  responses       PresenceResponse[]

  @@index([guildId, channelId])
  @@index([messageId])
  @@index([eventDate])
}

model PresenceResponse {
  id            String                   @id @default(cuid())
  presenceId    String
  presence      Presence                 @relation(fields: [presenceId], references: [id], onDelete: Cascade)
  userId        String
  status        ResponseStatus
  retardMinutes Int?
  respondedAt   DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt
  changes       PresenceResponseChange[]

  @@unique([presenceId, userId])
  @@index([presenceId, status])
  @@index([userId])
}

// historique des changements de réponse (ex: Présent -> Absent), pour /presence stats
model PresenceResponseChange {
  id         String            @id @default(cuid())
  responseId String
  response   PresenceResponse  @relation(fields: [responseId], references: [id], onDelete: Cascade)
  fromStatus ResponseStatus?
  toStatus   ResponseStatus
  changedAt  DateTime          @default(now())

  @@index([responseId])
}

// ---------- MODULE VEHICULES ----------

model Vehicle {
  id        String   @id @default(cuid())
  guildId   String
  plate     String
  ownerId   String
  modele    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([guildId, plate])
  @@index([guildId, ownerId])
}

model VehicleConfig {
  guildId            String   @id
  dashboardChannelId String?
  dashboardMessageId String?
  updatedAt          DateTime @updatedAt
}
