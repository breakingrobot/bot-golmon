generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

// ---------- MODULE TRANSACTIONS ----------

enum TransactionType {
  ACHAT
  VENTE
}

enum TransactionStatus {
  PREPARATION
  EN_ATTENTE_RDV
  AVANCE_ATTENTE_PAIEMENT
  LIVRE_PAYE
  ANNULEE
  CLOTUREE
}

model Transaction {
  id          String            @id @default(cuid())
  guildId     String
  channelId   String
  messageId   String?
  groupe      String
  type        TransactionType
  prix        Float
  statut      TransactionStatus @default(PREPARATION)
  createdById String
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  items       TransactionItem[]

  @@index([guildId, channelId])
  @@index([guildId, statut])
  @@index([messageId])
}

model TransactionConfig {
  guildId            String   @id
  dashboardChannelId String?
  dashboardMessageId String?
  pingRoleId         String?
  updatedAt          DateTime @updatedAt
}

model TransactionItem {
  id            String      @id @default(cuid())
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  nom           String
  quantite      Int         @default(1)
  prixUnitaire  Float?
  createdAt     DateTime    @default(now())

  @@index([transactionId])
}

// ---------- MODULE PRESENCES ----------

enum ResponseStatus {
  PRESENT
  ABSENT
  RETARD
}

model PresenceConfig {
  guildId           String   @id
  defaultRoleId     String?
  absenceRoleId     String?
  presenceChannelId String?
  reminderChannelId String?
  absenceChannelId  String?
  updatedAt         DateTime @updatedAt
}

model Absence {
  id          String    @id @default(cuid())
  guildId     String
  userId      String
  motif       String
  startsAt    DateTime
  endsAt      DateTime
  createdById String
  endedAt     DateTime?
  createdAt   DateTime  @default(now())

  @@index([guildId, userId])
  @@index([endedAt])
}

/// Membres à ne jamais ping pour les présences (auto-absents), indépendamment des absences ponctuelles.
model PresenceBlocklist {
  id        String   @id @default(cuid())
  guildId   String
  userId    String
  raison    String?
  addedById String
  createdAt DateTime @default(now())

  @@unique([guildId, userId])
}

model Presence {
  id             String             @id @default(cuid())
  guildId        String
  channelId      String
  messageId      String?
  titre          String
  description    String?
  eventDate      DateTime
  roleId         String
  absenceRoleId  String?
  createdById    String
  createdAt      DateTime           @default(now())
  closedAt       DateTime?
  lastReminderAt DateTime?
  responses      PresenceResponse[]

  @@index([guildId, channelId])
  @@index([messageId])
  @@index([eventDate])
}

model PresenceResponse {
  id            String                   @id @default(cuid())
  presenceId    String
  presence      Presence                 @relation(fields: [presenceId], references: [id], onDelete: Cascade)
  userId        String
  status        ResponseStatus
  retardMinutes Int?
  respondedAt   DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt
  changes       PresenceResponseChange[]

  @@unique([presenceId, userId])
  @@index([presenceId, status])
  @@index([userId])
}

// historique des changements de réponse (ex: Présent -> Absent), pour /presence stats
model PresenceResponseChange {
  id         String           @id @default(cuid())
  responseId String
  response   PresenceResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)
  fromStatus ResponseStatus?
  toStatus   ResponseStatus
  changedAt  DateTime         @default(now())

  @@index([responseId])
}

// ---------- MODULE VEHICULES ----------

model Vehicle {
  id          String   @id @default(cuid())
  guildId     String
  plate       String
  ownerId     String
  ownerIsRole Boolean  @default(false)
  modele      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([guildId, plate])
  @@index([guildId, ownerId])
}

model VehicleConfig {
  guildId            String   @id
  dashboardChannelId String?
  dashboardMessageId String?
  updatedAt          DateTime @updatedAt
}

// ---------- MODULE PROSPECTS ----------

enum ProspectVoteChoice {
  POUR
  CONTRE
  BLANC
}

model ProspectConfig {
  guildId            String   @id
  prospectRoleId     String?
  gradeRoleId        String?
  leadRoleId         String?
  categoryId         String?  // catégorie des salons privés prospects
  dashboardChannelId String?
  updatedAt          DateTime @updatedAt
}

/// Une semaine de vote. Une seule session ouverte par guilde à la fois.
model ProspectSession {
  id        String          @id @default(cuid())
  guildId   String
  weekStart DateTime        // lundi 00:00 Europe/Paris
  closedAt  DateTime?
  messageId String?         // message dashboard propre à la semaine
  createdAt DateTime        @default(now())
  entries   ProspectEntry[]

  @@unique([guildId, weekStart])
  @@index([guildId, closedAt])
}

/// Un prospect suivi pendant une session hebdomadaire.
model ProspectEntry {
  id        String          @id @default(cuid())
  sessionId String
  session   ProspectSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  guildId   String
  userId    String
  vetoById  String?
  vetoMotif String?
  vetoAt    DateTime?
  createdAt DateTime        @default(now())
  votes     ProspectVote[]

  @@unique([sessionId, userId])
  @@index([guildId, userId])
}

model ProspectVote {
  id        String             @id @default(cuid())
  entryId   String
  entry     ProspectEntry      @relation(fields: [entryId], references: [id], onDelete: Cascade)
  voterId   String
  choix     ProspectVoteChoice
  motif     String
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@unique([entryId, voterId])   // un avis par gradé, modifiable
  @@index([entryId, choix])
}

/// Salon privé d'un prospect — persiste au-delà des sessions hebdomadaires.
model ProspectChannel {
  id        String   @id @default(cuid())
  guildId   String
  userId    String
  channelId String
  createdAt DateTime @default(now())

  @@unique([guildId, userId])
}

// ---------- MODULE NUMEROS ----------

model PhoneNumber {
  id        String   @id @default(cuid())
  guildId   String
  userId    String
  numero    String   // normalisé : chiffres uniquement, 555XXXX à 555XXXXXX
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([guildId, userId])
  @@unique([guildId, numero])
  @@index([guildId, numero])
}

model PhoneConfig {
  guildId            String   @id
  dashboardChannelId String?
  dashboardMessageId String?
  updatedAt          DateTime @updatedAt
}
